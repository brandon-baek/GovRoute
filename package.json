{
  "name": "govguide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "python3 -m pipeline.run --source local",
    "graph:export": "tsx scripts/export-graph.ts",
    "pathways:export": "python3 -m pipeline.pathways",
    "gnn:train": "python3 ml/train_gnn.py",
    "db:seed": "tsx scripts/seed-database.ts",
    "db:stats": "tsx scripts/database-stats.ts",
    "ingest:usa": "python3 -m pipeline.run --source usagov",
    "ingest:california": "python3 -m pipeline.run --source california",
    "ingest:sam": "python3 -m pipeline.run --source sam",
    "ingest:federal-directory": "python3 -m pipeline.run --source federal-directory",
    "ingest:federal-sites": "python3 -m pipeline.run --source federal-sites",
    "ingest:government-directory": "python3 -m pipeline.run --source government-domain-directory",
    "ingest:government-sites": "python3 -m pipeline.run --source government-sites",
    "ingest:state-directory": "python3 -m pipeline.run --source state-directory",
    "ingest:state-sites": "python3 -m pipeline.run --source state-sites",
    "check:sources": "tsx scripts/check-sources.ts",
    "prebuild": "node scripts/prepare-registry.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.1.2",
    "d3": "^7.9.0",
    "fast-xml-parser": "^5.2.5",
    "next": "16.4.0",
    "openai": "^5.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "robots-parser": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "5.0.3",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "engines": {
    "node": "22.x"
  }
}
