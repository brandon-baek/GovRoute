# Optional. Govroute works without an LLM and never uses one as a factual source.
GOVROUTE_ENABLE_PAID_AI=false
# Per-process guard only; use host-wide firewall limits before enabling paid AI.
GOVROUTE_AI_ROUTES_PER_HOUR=20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Required only for the SAM.gov Assistance Listings connector.
SAM_API_KEY=

# Ingestion guardrails.
GOVROUTE_USER_AGENT=Govroute/1.0 (contact: your-email@example.com)
GOVROUTE_CRAWL_LIMIT=40
GOVROUTE_CRAWL_DELAY_SECONDS=0.25

# Optional override; the Govroute SQLite snapshot is still named data/govroute.db.
GOVROUTE_DB_PATH=
